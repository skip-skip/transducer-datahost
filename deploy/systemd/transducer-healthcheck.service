[Unit]
Description=Transducer stack healthcheck and alert
Documentation=file:/opt/transducer_dash/docs/operations.md
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=transducer
Group=transducer
WorkingDirectory=/opt/transducer_dash
EnvironmentFile=-/etc/transducer/ops.env
ExecStart=/opt/transducer_dash/scripts/healthcheck.sh
Nice=10
NoNewPrivileges=true
PrivateTmp=true
