# /etc/transducer/ops.env
#
# Optional overrides for scripts/backup.sh and scripts/healthcheck.sh, read by
# the systemd units in deploy/systemd. Values here take precedence over .env.
# POSTGRES_* come from the repository .env unless set here.
#
# Install with mode 0600 and owner root:
#   sudo install -m 0600 -o root -g root ops.env.example /etc/transducer/ops.env

BACKUP_DIR=/var/backups/transducer
BACKUP_RETENTION_DAYS=30
BACKUP_MONTHLY_RETENTION=12
# Copy the backup directory to a mounted network share after each run:
# BACKUP_REMOTE=/mnt/backups/transducer

# Slack-compatible incoming webhook. Leave unset to disable alerting.
# ALERT_WEBHOOK_URL=https://hooks.example.invalid/services/CHANGE_ME
ALERT_ON_WARNINGS=false
ALERT_REPEAT_SECONDS=3600
HEALTHCHECK_STATE_DIR=/var/lib/transducer-healthcheck

# Warn when no successful import has landed in this many hours. Uploads are
# manual, so the default is deliberately generous.
HEALTHCHECK_MAX_INGEST_AGE_HOURS=168

# Backlog thresholds in seconds (oldest queued or processing job).
HEALTHCHECK_BACKLOG_WARN_SECONDS=3600
HEALTHCHECK_BACKLOG_FAIL_SECONDS=21600

# Host path used for the Docker disk check.
# DOCKER_ROOT=/var/lib/docker
