# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# The compose file reads the POSTGRES_* values. The ingester and API read the
# connection values in their own environment (or inherit them from the host).

# ---------------------------------------------------------------------------
# PostgreSQL container
# ---------------------------------------------------------------------------
POSTGRES_DB=transducer
POSTGRES_USER=transducer_admin
POSTGRES_PASSWORD=change-me-admin
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Ingester connection (write role)
# ---------------------------------------------------------------------------
PGHOST=transducer-db
PGPORT=5432
PGDATABASE=transducer
INGEST_USER=transducer_ingest
INGEST_PASSWORD=change-me-ingest

# ---------------------------------------------------------------------------
# Read-only role (analysts and API)
# ---------------------------------------------------------------------------
READ_USER=transducer_read
READ_PASSWORD=change-me-read

# ---------------------------------------------------------------------------
# Time handling
# ---------------------------------------------------------------------------
# Timestamps are stored as naive local logger time. This zone is used to
# convert to/from UTC in the API and for reporting.
SITE_TIMEZONE=America/New_York

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Ingester defaults
# ---------------------------------------------------------------------------
# Default source folder. Override per run with `--source`.
INGEST_SOURCE=OneDrive_1_11-9-2026
# Skip files modified within this many seconds to avoid partial OneDrive syncs.
INGEST_SETTLE_SECONDS=120
