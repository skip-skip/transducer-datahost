# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# PostgreSQL settings use the canonical POSTGRES_* names. Compose reads them to
# initialize the container, and the ingester and API read the connection values
# from their own environment (or inherit them from the host).
#
# Roles:
#   POSTGRES_USER / POSTGRES_PASSWORD  admin/bootstrap role (provisioning only)
#   INGEST_USER / INGEST_PASSWORD      write role used by the loader
#   READ_USER / READ_PASSWORD          read-only role used by analysts and the API
#
# INGEST_PASSWORD and READ_PASSWORD are required on first initialization: the
# init scripts create both roles and fail fast if either is missing or empty.
# Changing them later in `.env` does not rotate the database passwords; use
# `ALTER ROLE ... PASSWORD` for rotation.

# ---------------------------------------------------------------------------
# PostgreSQL connection
# ---------------------------------------------------------------------------
# Host used by tools running on this machine. Compose services override this
# with `db`; remote hosts use the VM name or address.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=transducer

# ---------------------------------------------------------------------------
# Admin / provisioning role
# ---------------------------------------------------------------------------
POSTGRES_USER=transducer_admin
POSTGRES_PASSWORD=change-me-admin

# ---------------------------------------------------------------------------
# Ingester connection (write role)
# ---------------------------------------------------------------------------
INGEST_USER=transducer_ingest
# Required at first initialization.
INGEST_PASSWORD=change-me-ingest

# ---------------------------------------------------------------------------
# Read-only role (analysts and API)
# ---------------------------------------------------------------------------
READ_USER=transducer_read
# Required at first initialization.
READ_PASSWORD=change-me-read

# ---------------------------------------------------------------------------
# Time handling
# ---------------------------------------------------------------------------
# Timestamps are stored as naive local logger time. This zone is used to
# convert to/from UTC in the API and for reporting.
SITE_TIMEZONE=America/New_York

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Ingester defaults
# ---------------------------------------------------------------------------
# Default source folder. Override per run with `--source`.
INGEST_SOURCE=OneDrive_1_11-9-2026
# Skip files modified within this many seconds to avoid partial OneDrive syncs.
INGEST_SETTLE_SECONDS=120
