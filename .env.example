# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# PostgreSQL settings use the canonical POSTGRES_* names. Compose reads them to
# initialize the container, and the services read connection values from their
# own environment. The Windows uploader never receives a database credential.
#
# Roles:
#   POSTGRES_USER / POSTGRES_PASSWORD  admin/bootstrap role (provisioning only)
#   UPLOAD_USER / UPLOAD_PASSWORD      upload API; ingest.job only
#   INGEST_USER / INGEST_PASSWORD      worker/loader; domain tables + queue
#   READ_USER / READ_PASSWORD          read API and analysts; read-only
#
# The dashboard service has no database role and no database credentials. It
# calls the read API with the browser's read token and keeps its own JSON state
# on the `dashboard_state` volume.
#
# UPLOAD_PASSWORD, INGEST_PASSWORD, and READ_PASSWORD are required on first
# initialization: the init scripts create the roles and fail fast if any is
# missing or empty. Changing them later in `.env` does not rotate the database
# passwords; use `ALTER ROLE ... PASSWORD` or rerun the migrate service.

# ---------------------------------------------------------------------------
# PostgreSQL connection
# ---------------------------------------------------------------------------
# Host used by tools running on the VM itself. Compose services override this
# with `db`. PostgreSQL is not published on the host network.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=transducer

# ---------------------------------------------------------------------------
# Admin / provisioning role
# ---------------------------------------------------------------------------
POSTGRES_USER=transducer_admin
POSTGRES_PASSWORD=change-me-admin

# ---------------------------------------------------------------------------
# Upload API role (queue only)
# ---------------------------------------------------------------------------
UPLOAD_USER=transducer_upload
UPLOAD_PASSWORD=change-me-upload

# ---------------------------------------------------------------------------
# Ingester / worker connection (write role)
# ---------------------------------------------------------------------------
INGEST_USER=transducer_ingest
INGEST_PASSWORD=change-me-ingest

# ---------------------------------------------------------------------------
# Read-only role (read API)
# ---------------------------------------------------------------------------
READ_USER=transducer_read
READ_PASSWORD=change-me-read

# ---------------------------------------------------------------------------
# TLS front door
# ---------------------------------------------------------------------------
# Name clients use to reach the VM. The certificate in certs/ must match it.
INGEST_HOSTNAME=transducer.internal
# Host port published by Caddy. Nothing else is published.
CADDY_HTTPS_PORT=8443

# ---------------------------------------------------------------------------
# Ingest API tokens
# ---------------------------------------------------------------------------
# Comma-separated label:token pairs. Each uploader gets its own label so the
# audit log and ingest.job.source_client identify who sent the file. Generate
# tokens with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_API_TOKENS=workstation-1:change-me-ingest-token

# Token used by this Windows machine's uploader. It must match one of the
# values in INGEST_API_TOKENS. Prefer setting it in the user environment rather
# than in this file.
INGEST_API_TOKEN=change-me-ingest-token
# Base URL used by `transducer-ingest upload`.
INGEST_API_URL=https://transducer.internal:8443/ingest

# ---------------------------------------------------------------------------
# Read API tokens
# ---------------------------------------------------------------------------
# Comma-separated label:token pairs. Issue one per analyst or dashboard.
READ_API_TOKENS=analyst-1:change-me-read-token

# ---------------------------------------------------------------------------
# Dashboard service
# ---------------------------------------------------------------------------
# The dashboard has no database credentials. It signs a session cookie with
# this key and stores its layout state on the `dashboard_state` volume.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DASHBOARD_SECRET_KEY=change-me-dashboard-secret-at-least-16-chars
DASHBOARD_SESSION_MAX_AGE=28800
DASHBOARD_DEFAULT_WINDOW_DAYS=7
DASHBOARD_MAX_POINTS=2000
# Labels allowed to edit shared figures. Empty means any valid read key may.
DASHBOARD_SHARED_EDITORS=
# Set to false only for plain-HTTP local development.
DASHBOARD_COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# API and worker limits
# ---------------------------------------------------------------------------
READ_MAX_ROWS=10000
READ_MAX_WINDOW_DAYS=31
MAX_UPLOAD_BYTES=10485760
WORKER_POLL_SECONDS=2
WORKER_LOCK_TIMEOUT_SECONDS=600
WORKER_MAX_ATTEMPTS=3
WORKER_BACKOFF_SECONDS=30
WORKER_HEARTBEAT_TIMEOUT_SECONDS=60
SPOOL_PROCESSED_RETENTION_DAYS=30
SPOOL_FAILED_RETENTION_DAYS=90
# Leave disabled on the internal VM unless you need the interactive docs.
API_DOCS_ENABLED=false
INGEST_DOCS_ENABLED=false
# Comma-separated browser origins allowed to call the read API. Empty means
# no CORS headers are sent (server-to-server clients are unaffected).
API_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Time handling
# ---------------------------------------------------------------------------
# Timestamps are stored as naive local logger time. This zone is used to
# convert to/from UTC in the API and for reporting.
SITE_TIMEZONE=America/New_York

# ---------------------------------------------------------------------------
# Uploader defaults
# ---------------------------------------------------------------------------
# Skip files modified within this many seconds to avoid partial OneDrive syncs.
INGEST_SETTLE_SECONDS=120
# Optional CA bundle for the uploader when the mkcert root is not in the
# Windows trust store. Example: C:\Users\you\AppData\Local\mkcert\rootCA.pem
# INGEST_CA_CERT=
