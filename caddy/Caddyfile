# Caddy TLS front door for the ingest gateway and read API.
#
# The public listener is :8443. Caddy terminates TLS with the certificate in
# /etc/caddy/certs (see certs/README.md) and routes by path prefix:
#
#   /ingest/*    -> ingest-api:8080   (prefix stripped)
#   /api/*       -> read-api:8080     (prefix stripped)
#   /dashboard/* -> dashboard:8080    (prefix stripped; app root_path is
#                                      /dashboard so generated URLs keep the
#                                      prefix)
#
# The listener is a catch-all so clients may use either INGEST_HOSTNAME or the
# VM's IP address. Only Caddy is reachable from the host. PostgreSQL and the
# application containers stay on the internal Compose network.

{
	admin off
	auto_https off
	# Clients that connect to an IP literal do not send SNI (RFC 6066 forbids
	# it). Without a default, Caddy has no certificate to serve and aborts the
	# handshake with a TLS internal_error alert.
	default_sni {$INGEST_HOSTNAME:transducer.internal}
}

# Catch-all HTTPS listener. Certificate selection uses SNI (or default_sni
# above); requests are routed by path only, not by Host header.
https://:8443 {
	tls /etc/caddy/certs/server.crt /etc/caddy/certs/server.key

	encode zstd gzip

	# The uploader posts to https://host:8443/ingest/v1/uploads.
	handle_path /ingest/* {
		reverse_proxy ingest-api:8080
	}

	# Analysts and dashboards use https://host:8443/api/loggers, and so on.
	handle_path /api/* {
		reverse_proxy read-api:8080
	}

	# Browser dashboard. The prefix is stripped here and restored by the app's
	# --root-path /dashboard so redirects and static URLs stay under /dashboard.
	handle_path /dashboard/* {
		reverse_proxy dashboard:8080
	}

	handle {
		respond "Not found" 404
	}

	log {
		output stdout
		format json
	}
}
